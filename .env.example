# Copy to .env and adjust. Never commit .env.
#
# REQUIRED before `docker compose up` (the app stops with a message naming what is missing):
#   ANTHROPIC_API_KEY   your Claude API key
#   PII_ENCRYPTION_KEY  ┐ both filled by ONE command (never overwrites a value already set):
#   API_KEYS            ┘   docker compose run --rm --no-deps -v "$PWD:/work" -w /work app copilot setup
#                       It also writes the plain keys to .support-copilot-keys and the Postman
#                       environment postman/local.postman_environment.json (both gitignored).
# OPTIONAL: LANGSMITH_API_KEY (LLM tracing), HUGGINGFACE_API_KEY (the gated injection guard;
#   without it the measured no-token fallback is used automatically).
# Everything else works as is. Under Docker, docker-compose.yml overrides DATABASE_URL, HOST and
# OTEL_EXPORTER_OTLP_ENDPOINT; the values below are for running with `uv run` on the host.

# Vector store (D7): pgvector | memory
VECTOR_STORE=pgvector
DATABASE_URL=postgresql://copilot:copilot@localhost:5433/copilot

# Connections kept open to Postgres, shared by all requests (copilot/db.py)
DB_POOL_SIZE=10
# Embedding model (D2): any key in copilot/retrieval/embeddings.py MODELS
EMBEDDING_MODEL=bge-m3

# Logging: DEBUG | INFO | WARNING | ERROR; format json | text
LOG_LEVEL=INFO
LOG_FORMAT=text
# File logs: always JSON, rotated (10 MB × 5 files). Empty LOG_FILE = console only.
LOG_FILE=logs/copilot.log
LOG_MAX_MB=10
LOG_BACKUPS=5

# Server
HOST=127.0.0.1
PORT=8000

# Set the real key in .env only (never committed). Required: the LLM nodes call Claude.
ANTHROPIC_API_KEY=

# API auth (server/auth.py): name:role:sha256-of-key, comma-separated. Roles: helpdesk | agent.
# Create a key:  docker compose run --rm --no-deps app copilot keys new sara agent
#   (or `uv run copilot keys new sara agent`): prints the key ONCE + the name:role:hash line to add here
# Empty = every protected endpoint answers 401.
API_KEYS=
# Swagger /docs, /redoc, /openapi.json: true for development, false in production
API_DOCS=true

# LLM (D2): model IDs are config. Benchmark configurations swap these two values.
LLM_CLASSIFY_MODEL=claude-haiku-5-5
LLM_DRAFT_MODEL=claude-haiku-5-5
# Seconds per LLM call before it is retried (LangGraph RetryPolicy) and, after retries, routed to a person
LLM_TIMEOUT_S=30
# Ticket workflow (D3, D4)
RETRIEVAL_TOP_K=5
# bge-m3 value from `copilot eval retrieval` (eval/results/retrieval_bge-m3.json); per model
WEAK_RETRIEVAL_THRESHOLD=0.44
# Classifier self-reported confidence below this → reason low_confidence → a person reviews (D14)
CONFIDENCE_THRESHOLD=0.7
# Languages routed with an English draft (PRD FR-5.1 low_resource_language)
LOW_RESOURCE_LANGUAGES=ckb,sw
# Append-only audit log (PRD §6b): masked text, versions, sources, routing
AUDIT_LOG=logs/audit.jsonl

# PII masking (FR-1.3): patterns for IDs + NER for names/addresses.
# gliner = multilingual (Arabic, Russian, ...; ~1 GB model, downloaded on first use); spacy = English only
PII_NER=gliner
PII_GLINER_MODEL=urchade/gliner_multi_pii-v1
# Scores alone do not separate names from "friend"/"I"; pii.py adds lexical rules on top
PII_GLINER_THRESHOLD=0.5

# PII vault: Fernet key (32 url-safe base64 bytes). Generate one:
#   docker compose run --rm --no-deps app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   (or the same with `uv run python -c ...`). Changing it later makes stored mappings unreadable.
PII_ENCRYPTION_KEY=
# Mapping rows are deleted after this many days (audit log keeps only masked text)
PII_RETENTION_DAYS=30

# End-to-end monitoring (D6): OpenTelemetry → Collector → Grafana (Tempo, Prometheus, Loki).
# Local: `docker compose up -d lgtm` → Grafana http://localhost:3000. Docker sets lgtm:4318 itself.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=support-copilot

# LLM tracing (D6): LangSmith, debugging only (the audit log above is the legal record).
# Only PII-masked text is traced. Empty LANGSMITH_API_KEY = tracing off.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=support-copilot
LANGSMITH_AGENT_ENVIRONMENT=local
LANGSMITH_API_KEY=

# Prompt-injection detector for the injection gate (D12). Measured with `copilot eval injection`.
# Measured best: Llama Prompt Guard 2 (gated: needs HUGGINGFACE_API_KEY). No-token fallback:
# NeuralTrust/prompt-guard-oss-small (MIT).
INJECTION_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
# Hugging Face read token: needed only for gated models (Llama Prompt Guard 2: also accept Meta's
# licence on the model page). Empty or no access → NeuralTrust/prompt-guard-oss-small is used
# automatically, with a warning in the log.
HUGGINGFACE_API_KEY=
